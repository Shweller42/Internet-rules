<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Primary">#667EEA</Color>
    <Color x:Key="PrimaryDark">#5A67D8</Color>
    <Color x:Key="PrimaryDarker">#4C51BF</Color>
    <Color x:Key="PrimaryLight">#EBF4FF</Color>
    <Color x:Key="PrimaryLighter">#F0F5FF</Color>
    <Color x:Key="FooterBg">#1E293B</Color>
    <Color x:Key="FooterMuted">#334155</Color>
    <Color x:Key="Accent">#14B8A6</Color>
    <Color x:Key="AccentLight">#CCFBF1</Color>
    <Color x:Key="Success">#48BB78</Color>
    <Color x:Key="Danger">#FC8181</Color>
    <Color x:Key="DangerBg">#FEE2E2</Color>
    <Color x:Key="DangerText">#DC2626</Color>
    <Color x:Key="Bg">#F7FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#2D3748</Color>
    <Color x:Key="TextSecondary">#A0AEC0</Color>
    <Color x:Key="Border">#E2E8F0</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{DynamicResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryDarkerBrush" Color="{DynamicResource PrimaryDarker}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLight}"/>
    <SolidColorBrush x:Key="PrimaryLighterBrush" Color="{DynamicResource PrimaryLighter}"/>
    <SolidColorBrush x:Key="FooterBgBrush" Color="{DynamicResource FooterBg}"/>
    <SolidColorBrush x:Key="FooterMutedBrush" Color="{DynamicResource FooterMuted}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource Accent}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{DynamicResource AccentLight}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource Success}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource Danger}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{DynamicResource DangerBg}"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="{DynamicResource DangerText}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource Bg}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource Surface}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource Border}"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Opacity="0.08" ShadowDepth="4" Direction="270" Color="#000000"/>

    <Style TargetType="Window" x:Key="ModernWindow">
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="ThemeCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<Page x:Class="WpfApp1.TopicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="40,36,40,0">
            <TextBlock Text="Выберите тему для изучения" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="В каждой теме вас ждут правила, тест, сортировка и кейс-задание"
                       FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,28"/>

            <ItemsControl x:Name="TopicsList" Margin="0,0,0,32">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Height="90" Margin="0,0,0,10" Cursor="Hand"
                                Tag="{Binding Id}" MouseLeftButtonDown="Topic_Click">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Icon}" FontSize="32"
                                           VerticalAlignment="Center" Margin="20,0,14,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                           Foreground="{Binding StatusForeground}"
                                           FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,18,0"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,20,0">
                                    <Button Content="Продолжить" Height="44" MinWidth="120"
                                            Style="{StaticResource PrimaryButton}" Padding="14,10"
                                            VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0"
                                            Tag="{Binding Id}" Click="Continue_Click"
                                            Visibility="{Binding HasActiveSession, Converter={StaticResource BoolToVis}}"/>
                                    <Button Height="44" MinWidth="120"
                                            Padding="14,10"
                                            VerticalAlignment="Center" FontSize="14"
                                            Tag="{Binding Id}" Click="Start_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Content" Value="Начать"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveSession}" Value="True">
                                                        <Setter Property="Content" Value="Начать заново"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
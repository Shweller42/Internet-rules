<Page x:Class="WpfApp1.ThemeListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctrl="clr-namespace:WpfApp1.Controls"
      Background="{DynamicResource BgBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel>
            <StackPanel Margin="40,36,40,0">
                <TextBlock Text="Выберите тему для изучения" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Узнайте о правилах безопасного поведения в сети Интернет" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,32"/>

                <ItemsControl x:Name="ThemesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ThemeCard}" Width="250" MinHeight="420" Margin="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="48" HorizontalAlignment="Center" Margin="0,8,0,6"/>
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" Grid.Row="1" Margin="0,0,0,9"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Grid.Row="2" Margin="0,0,0,12"/>
                                    <ctrl:SpeedometerControl Grid.Row="3" Percentage="{Binding ProgressPct}"
                                                             Width="120" Height="70"
                                                             HorizontalAlignment="Center" Margin="0,0,0,4"
                                                             Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Начать обучение" Style="{StaticResource PrimaryButton}"
                                            Grid.Row="4" Height="48" Padding="20,10"
                                            Tag="{Binding Id}" Click="Theme_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="24" Margin="0,28,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📊" FontSize="32" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Ваш прогресс" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ProgressText" Text="Пока нет пройденных тем"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Content="Подробнее" Height="38" FontSize="12"
                                FontWeight="SemiBold" MinWidth="100" Cursor="Hand"
                                Grid.Column="2" HorizontalAlignment="Right" Margin="0,4,12,4"
                                Padding="14,8"
                                Style="{StaticResource PrimaryButton}"
                                Click="Progress_Click"/>
                        <Button Content="Сбросить прогресс" Height="38" FontSize="12"
                                FontWeight="SemiBold" Width="150" Cursor="Hand"
                                Grid.Column="3" HorizontalAlignment="Right" Margin="0,4,0,4"
                                Click="Reset_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBg" Background="#FEE2E2"
                                            CornerRadius="8" Padding="0" Height="38"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <ContentPresenter x:Name="Content"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="#DC2626"
                                                          TextElement.FontSize="12"
                                                          TextElement.FontWeight="SemiBold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ScaleT"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     To="1.08" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="ScaleT"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     To="1.08" Duration="0:0:0.12"/>
                                                    <ColorAnimation Storyboard.TargetName="BtnBg"
                                                                    Storyboard.TargetProperty="Background.Color"
                                                                    To="#FCA5A5" Duration="0:0:0.12"/>
                                                    <ColorAnimation Storyboard.TargetName="Content"
                                                                    Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                                    To="#991B1B" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ScaleT"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     To="1" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="ScaleT"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     To="1" Duration="0:0:0.12"/>
                                                    <ColorAnimation Storyboard.TargetName="BtnBg"
                                                                    Storyboard.TargetProperty="Background.Color"
                                                                    To="#FEE2E2" Duration="0:0:0.12"/>
                                                    <ColorAnimation Storyboard.TargetName="Content"
                                                                    Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                                    To="#DC2626" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border CornerRadius="16" Margin="0,24,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel Margin="32,28,32,24">
                        <TextBlock Text="📘 О приложении" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                        <TextBlock LineHeight="20" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Это интерактивное приложение создано для обучения правилам безопасного поведения в сети Интернет. "/>
                            <Run Text="Включает три темы: "/>
                            <Run Text="Законы РБ" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Run Text=", "/>
                            <Run Text="Негласные правила" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Run Text=" и "/>
                            <Run Text="Опасные ситуации" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Run Text=". Каждая тема содержит теорию, тест, сортировку и кейс-задание."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- FOOTER -->
            <Border Background="{DynamicResource PrimaryDarkerBrush}" Height="118" Margin="0,32,0,0"
                    ClipToBounds="True">
                <Canvas>
                    <Ellipse Canvas.Left="-60" Canvas.Top="-130" Width="200" Height="200" Opacity="0.045" Fill="White"/>
                    <Ellipse Canvas.Left="810" Canvas.Top="-30" Width="110" Height="110" Opacity="0.07" Fill="White"/>
                    <Ellipse Canvas.Left="247" Canvas.Top="82" Width="116" Height="104" Opacity="0.08" Fill="White">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-18"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="366" Canvas.Top="18" Width="94" Height="93" Opacity="0.11" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-28"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="570" Canvas.Top="43" Width="54" Height="56" Opacity="0.14" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-25"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="145" Canvas.Top="-58" Width="140" Height="140" Opacity="0.035" Fill="#1A202C"/>
                    <Ellipse Canvas.Left="643" Canvas.Top="-13" Width="50" Height="50" Opacity="0.05" Fill="#1A202C"/>
                    <Ellipse Canvas.Left="484" Width="75" Height="75" Opacity="0.04" Fill="#1A202C" Canvas.Top="-26"/>
                    <Ellipse Canvas.Left="77" Canvas.Top="100" Width="59" Height="60" Opacity="0.08" Fill="#1A202C">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-8"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="499" Canvas.Top="70" Width="46" Height="47" Opacity="0.12" Fill="#1A202C"/>
                    <Ellipse Canvas.Left="619" Canvas.Top="47" Width="200" Height="200" Opacity="0.045" Fill="White"/>
                    <Ellipse Canvas.Left="1199" Canvas.Top="-23" Width="140" Height="140" Opacity="0.035" Fill="#1A202C"/>
                </Canvas>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

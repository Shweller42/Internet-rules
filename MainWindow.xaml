<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BgBrush}"
        WindowStyle="None"
        Title="Безопасный интернет"
        WindowStartupLocation="CenterScreen"
        Width="960" Height="700"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewMouseDown="MainWindow_PreviewMouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="30" ResizeBorderThickness="6" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============= HEADER ============= -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryDarkerBrush}" ClipToBounds="True"
                MouseDown="Header_MouseDown">
            <Canvas>
                <Ellipse Canvas.Left="-40" Canvas.Top="-70" Width="180" Height="180" Opacity="0.035" Fill="White"/>
                <Ellipse Canvas.Left="489" Canvas.Top="35" Width="130" Height="130" Opacity="0.055" Fill="White"/>
                <Ellipse Canvas.Left="677" Canvas.Top="68" Width="95" Height="88" Opacity="0.08" Fill="White">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-18"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="275" Canvas.Top="-28" Width="72" Height="74" Opacity="0.1" Fill="White">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="12.5"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="294" Canvas.Top="72" Width="48" Height="48" Opacity="0.13" Fill="White"/>
                <Ellipse Canvas.Left="192" Canvas.Top="22" Width="28" Height="28" Opacity="0.16" Fill="White">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="35"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="140" Canvas.Top="63" Width="140" Height="140" Opacity="0.025" Fill="#1A202C"/>
                <Ellipse Canvas.Left="361" Canvas.Top="-21" Width="65" Height="60" Opacity="0.05" Fill="#1A202C">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-22.5"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="357" Canvas.Top="58" Width="85" Height="84" Opacity="0.035" Fill="#1A202C"/>
                <Ellipse Canvas.Left="814" Canvas.Top="-64" Width="120" Height="113" Opacity="0.07" Fill="#1A202C">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="28"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="652" Canvas.Top="20" Width="22" Height="22" Opacity="0.11" Fill="#1A202C"/>
                <Ellipse Canvas.Left="872" Canvas.Top="76" Width="110" Height="110" Opacity="0.04" Fill="White"/>
                <Ellipse Canvas.Left="554" Canvas.Top="-29" Width="50" Height="49" Opacity="0.11" Fill="#1A202C" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Canvas>
        </Border>

        <!-- Header content -->
        <Grid Grid.Row="0" Background="Transparent" MouseDown="Header_MouseDown">
            <StackPanel x:Name="MainHeaderContent" VerticalAlignment="Center" Margin="40,0,0,0">
                <TextBlock x:Name="TitleText" Text="Безопасный интернет" FontSize="44" FontWeight="ExtraBold"
                           FontFamily="Raleway"
                           Foreground="White"/>
                <TextBlock x:Name="SubtitleText" Text="Интерактивное обучение цифровой грамотности" FontSize="16" FontWeight="Medium"
                           FontFamily="Raleway"
                           Foreground="#CBD5E1" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel x:Name="ThemeHeaderContent" VerticalAlignment="Center" Margin="40,0,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock x:Name="ThemeIconText" FontSize="28" Foreground="White"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="ThemeTitleText" FontSize="28" FontWeight="ExtraBold"
                               FontFamily="Raleway" Foreground="White" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="BackBtn" Width="36" Height="36"
                    Background="Transparent" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,76,0"
                    Visibility="Collapsed" Click="BackBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="18"
                                Background="Transparent"
                                BorderBrush="#FFFFFF66" BorderThickness="1.5"
                                Width="36" Height="36">
                            <Viewbox Stretch="Uniform" MaxWidth="22" MaxHeight="22">
                                <TextBlock Text="←" Foreground="White" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="CloseBtn" Content="✕" Width="36" Height="36"
                    Background="Transparent" Foreground="White" FontSize="18"
                    Cursor="Hand" BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,28,0"
                    Click="CloseBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="18" Background="{TemplateBinding Background}"
                                BorderBrush="#FFFFFF66" BorderThickness="1.5"
                                Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFFFF33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ============= CONTENT ============= -->
        <Border Grid.Row="1" Background="{DynamicResource BgBrush}" CornerRadius="0,0,30,30"/>
        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="0"/>
    </Grid>
</Window>

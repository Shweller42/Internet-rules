<Page x:Class="WpfApp1.ResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgBrush}" Title="Результат">
    <ScrollViewer>
        <Grid Margin="32">
            <StackPanel>
                <TextBlock x:Name="ThemeLabel" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,24"/>

                <!-- Score card -->
                <Border Background="White" CornerRadius="20" Padding="32" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Circular progress -->
                        <Border Width="160" Height="160" CornerRadius="80"
                                Background="{DynamicResource BgBrush}">
                            <Border Width="140" Height="140" CornerRadius="70"
                                    Background="White">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="PercentText" FontSize="36"
                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="GradeText" FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock x:Name="ScoreText" FontSize="16" Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="ErrorCountText" FontSize="14"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- All answers -->
                <Border Background="White" CornerRadius="20" Padding="32" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Visibility="Collapsed" x:Name="AnswerSection">
                    <StackPanel>
                        <TextBlock Text="📝 Ваши ответы" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="AnswersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10"
                                            Padding="16,12" Margin="0,0,0,8"
                                            Background="{Binding Background}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Question}" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Вы: " FontSize="13" Foreground="{Binding TextColor}"/>
                                                <TextBlock Text="{Binding UserAnswer}" FontSize="13"
                                                           Foreground="{Binding TextColor}" Margin="0,0,16,0"/>
                                                <TextBlock Text="✓ " FontSize="13" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{Binding CorrectAnswer}" FontSize="13"
                                                           Foreground="{DynamicResource SuccessBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="📖 К правилам" Style="{StaticResource PrimaryButton}"
                            Height="44" MinWidth="180" Padding="20,10" Click="Retry_Click"/>
                    <Button Content="← На главную" Style="{StaticResource PrimaryButton}"
                            Height="44" MinWidth="180" Padding="20,10" Margin="12,0,0,0" Click="Home_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="WpfApp1.TheoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgBrush}" Title="Теория">
    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,0,6,0">
                            <Border Background="#E2E8F0"
                                    CornerRadius="14" Margin="0,8,0,8"/>
                            <Track Name="PART_Track"
                                   Margin="0,8,0,8">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="14"
                                                        Background="#4C51BF"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="40,28,40,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TopicIcon" FontSize="32" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TopicTitle" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="TopicDesc" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Content="🧪 Пройти тестирование" Style="{StaticResource PrimaryButton}"
                    Height="42" Padding="20,10" FontSize="14"
                    Grid.Column="1" VerticalAlignment="Center" Click="GoToTest"/>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="RulesScrollViewer">
            <StackPanel x:Name="RulesPanel" Margin="40,0,40,40"/>
        </ScrollViewer>
    </Grid>
</Page>
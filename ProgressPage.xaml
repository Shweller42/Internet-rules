<Page x:Class="WpfApp1.ProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgBrush}" Title="Прогресс">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel>
            <Grid Margin="32">
                <StackPanel>
                    <TextBlock Text="📊 Ваш прогресс" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,24"/>

                    <!-- Stats cards row -->
                    <ItemsControl x:Name="StatsCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="14"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Width="180" Height="90" Margin="0,0,12,12"
                                        Padding="16,14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pie chart -->
                    <Border Background="White" CornerRadius="20" Padding="32" Margin="0,12,0,16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🥧 Распределение результатов" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Canvas x:Name="PieCanvas" Width="220" Height="220"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <ItemsControl x:Name="PieLegend">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Width="12" Height="12" CornerRadius="6"
                                                            Background="{Binding Color}"
                                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="13"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Per-topic bar chart -->
                    <Border Background="White" CornerRadius="20" Padding="32" Margin="0,0,0,16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📈 Прогресс по темам" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>
                            <Canvas x:Name="BarCanvas" Height="220" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Least errors -->
                    <Border Background="White" CornerRadius="20" Padding="32" Margin="0,0,0,24"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="Collapsed" x:Name="ErrorsSection">
                        <StackPanel>
                            <TextBlock Text="📉 Анализ ошибок" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="LeastErrorsText" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="MostErrorsText" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="← На главную" Style="{StaticResource PrimaryButton}"
                            Height="44" MinWidth="180" Padding="20,10"
                            HorizontalAlignment="Center" Click="Home_Click" Margin="0,8,0,12"/>
                </StackPanel>
            </Grid>

            <!-- FOOTER (matches main menu exactly) -->
            <Border Background="{DynamicResource PrimaryDarkerBrush}" Height="118" Margin="0,12,0,0"
                    ClipToBounds="True">
                <Canvas>
                    <Ellipse Canvas.Left="-60" Canvas.Top="-130" Width="200" Height="200" Opacity="0.045" Fill="White"/>
                    <Ellipse Canvas.Left="810" Canvas.Top="-30" Width="110" Height="110" Opacity="0.07" Fill="White"/>
                    <Ellipse Canvas.Left="247" Canvas.Top="82" Width="116" Height="104" Opacity="0.08" Fill="White">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-18"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="366" Canvas.Top="18" Width="94" Height="93" Opacity="0.11" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-28"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="570" Canvas.Top="43" Width="54" Height="56" Opacity="0.14" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-25"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="145" Canvas.Top="-58" Width="140" Height="140" Opacity="0.035" Fill="#1A202C"/>
                    <Ellipse Canvas.Left="643" Canvas.Top="-13" Width="50" Height="50" Opacity="0.05" Fill="#1A202C"/>
                    <Ellipse Canvas.Left="484" Width="75" Height="75" Opacity="0.04" Fill="#1A202C" Canvas.Top="-26"/>
                    <Ellipse Canvas.Left="77" Canvas.Top="100" Width="59" Height="60" Opacity="0.08" Fill="#1A202C">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-8"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Canvas.Left="499" Canvas.Top="70" Width="46" Height="47" Opacity="0.12" Fill="#1A202C"/>
                    <Ellipse Canvas.Left="619" Canvas.Top="47" Width="200" Height="200" Opacity="0.045" Fill="White"/>
                    <Ellipse Canvas.Left="1199" Canvas.Top="-23" Width="140" Height="140" Opacity="0.035" Fill="#1A202C"/>
                </Canvas>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
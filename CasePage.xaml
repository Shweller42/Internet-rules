<Page x:Class="WpfApp1.CasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgBrush}" Title="Кейс">
    <Page.Resources>
        <Style x:Key="OptionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Cursor="{TemplateBinding Cursor}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="WrappingTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,2"/>
        </DataTemplate>

        <Style x:Key="ResultBtn" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Background" Value="#A0AEC0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <TextBlock Text="🎯 Кейс-задание" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="StageInfo" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="32" MinHeight="200">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#FFF5F5" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="📋 Ситуация" FontSize="12" Foreground="#C53030"
                                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="SituationText" FontSize="16"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" LineHeight="24"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="OptionsPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Style="{StaticResource OptionBtn}"
                                            ContentTemplate="{StaticResource WrappingTemplate}"
                                            Click="Option_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="ExplanationBox" CornerRadius="12"
                                Padding="24" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ExplanationTitle" FontSize="14" FontWeight="Bold"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="ExplanationText" FontSize="14"
                                           TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Button x:Name="FinishCaseBtn" Content="К результату →" Style="{StaticResource ResultBtn}"
                        Height="42" MinWidth="170" Padding="20,10" HorizontalAlignment="Right" Margin="0,16,0,0"
                        Background="{DynamicResource SuccessBrush}" Visibility="Collapsed"
                        Click="Finish_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>